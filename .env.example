# ─── Anthropic Claude API ────────────────────────────────────────────────────
# Required for AI conversation engine (claude-haiku-20240307)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── ElevenLabs TTS ──────────────────────────────────────────────────────────
# Optional — falls back to Twilio Polly TTS if not set
# Get yours at: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # Default: "Bella" — warm female voice

# ─── Twilio ──────────────────────────────────────────────────────────────────
# Required for phone call handling
# Get yours at: https://twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── App Config ──────────────────────────────────────────────────────────────
# Public URL of this server (used to build audio file URLs for Twilio)
# Local dev: use ngrok → https://abc123.ngrok.io
# Railway: https://your-app.up.railway.app
BASE_URL=https://your-domain.up.railway.app

# Office phone number for warm transfers (E.164 format)
OFFICE_PHONE=+14105550100

# Port (Railway sets this automatically)
PORT=8000
